{
	"name": "@mistereman22/osrs-wiki-mcp-server",
	"version": "1.0.3",
	"description": "MCP server for the Old School RuneScape Wiki: the full MediaWiki MCP tool surface against a pinned read-only wiki.",
	"type": "module",
	"main": "./dist/index.js",
	"bin": {
		"osrs-wiki-mcp-server": "./dist/index.js"
	},
	"files": [
		"dist/**/*",
		"resources/**/*"
	],
	"scripts": {
		"build": "tsc",
		"start": "node dist/index.js",
		"dev": "tsc && node dist/index.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mistereman22/osrs-wiki-mcp-server.git"
	},
	"keywords": [
		"mcp",
		"model-context-protocol",
		"mediawiki",
		"osrs",
		"runescape",
		"wiki"
	],
	"author": "mistereman22",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/mistereman22/osrs-wiki-mcp-server/issues"
	},
	"homepage": "https://github.com/mistereman22/osrs-wiki-mcp-server#readme",
	"dependencies": {
		"@modelcontextprotocol/server": "^2.4.0",
		"@professional-wiki/mediawiki-mcp-server": "^0.21.0",
		"axios": "^1.21.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"typescript": "^7.0.2"
	}
}
